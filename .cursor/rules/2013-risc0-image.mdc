    fn unsafe_load(data: &[u8]) -> Image {
        let program = Program::load_elf(data, u32::MAX).unwrap(); // No validation
        let img = MemoryImage::new(&program, 4096).unwrap(); // Hard-coded page size
        
        Image {
            id: "unknown".to_string(), // Missing proper ID
            bytes: Some(Bytes::from(data)),
            data: Some(program),
            size: data.len() as u64, // Wrong size calculation
            path: PathBuf::new(),
            last_used: 0,
        }
    }
}
