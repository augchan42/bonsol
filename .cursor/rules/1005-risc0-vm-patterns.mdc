<example>
// Good: Error handling with context
pub fn verify_proof(proof: &[u8]) -> Result<Receipt> {
    let start_time = Instant::now();
    
    match bincode::deserialize(proof) {
        Ok(receipt) => {
            trace!(
                "Proof verification successful:\n\
                 - Size: {} bytes\n\
                 - Duration: {:?}",
                proof.len(),
                start_time.elapsed()
            );
            Ok(receipt)
        }
        Err(e) => {
            error!(
                "Proof verification failed:\n\
                 - Error: {}\n\
                 - Size: {} bytes\n\
                 - Duration: {:?}",
                e,
                proof.len(),
                start_time.elapsed()
            );
            Err(anyhow::anyhow!("Proof verification failed: {}", e))
        }
    }
}
</example>

