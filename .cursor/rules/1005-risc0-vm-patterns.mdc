<example>
// Good: Proper iteration and logging
pub fn process_inputs(inputs: Vec<Input>) -> Result<()> {
    let start_time = Instant::now();
    
    // Use iter() to preserve ownership
    for (idx, input) in inputs.iter().enumerate() {
        trace!(
            "Processing input {}/{} - Details:\n\
             - Type: {:?}\n\
             - Size: {} bytes",
            idx + 1,
            inputs.len(),
            input.type_info(),
            input.size()
        );
        // Processing logic
    }
    
    info!(
        "Processing complete:\n\
         - Total inputs: {}\n\
         - Duration: {:?}",
        inputs.len(),
        start_time.elapsed()
    );
    Ok(())
}
</example>

